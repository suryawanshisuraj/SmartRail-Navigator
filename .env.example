# SmartRail Navigator — Environment Variables
# Copy this file to .env and adjust values for your environment.

# Backend server port
PORT=5000

# Node environment
NODE_ENV=development

# Allowed CORS origins (comma-separated). Frontend dev server + backend.
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# OSM Overpass cache TTL in milliseconds (default: 24 hours)
OSM_CACHE_TTL_MS=86400000

# PostgreSQL connection string (optional — app uses in-memory fallback if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/smartrail

# Set to 'true' when deploying to Vercel serverless
# VERCEL=true
